{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "node --check *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "pytest*": "allow",
      "python -m app.cli*": "allow"
    },
    "webfetch": "deny",
    "websearch": "deny"
  }
}
